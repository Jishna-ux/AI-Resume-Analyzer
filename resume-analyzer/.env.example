# Copy this file to ".env" (same folder) and fill in real values. NEVER commit ".env".

# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- MongoDB ---
# Local:  mongodb://127.0.0.1:27017/resume_analyzer
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resume_analyzer
MONGODB_URI=your_mongodb_connection_string

# --- Authentication ---
# Use a long random string, e.g. run:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=JWT_SECRET
JWT_EXPIRES_IN=7d

# --- AI provider (kept on the server only) ---
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI_TIMEOUT_MS=60000

# --- Uploads ---
MAX_FILE_SIZE_MB=5

# --- First admin account (used only by: npm run seed:admin) ---
ADMIN_NAME=Administrator_name
ADMIN_EMAIL=email.admin@example.com
ADMIN_PASSWORD=change_this_password_1_2
